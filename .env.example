# Copy to .env locally for testing. On Zeabur, set these in the dashboard.

# === ElevenLabs (required) ===
# 璃 6/2 選妃選中的那個低沉 ASMR 音色 Voice ID
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=xxxxxxxxxxxxxxxxxxxx
# 中文要用 multilingual,純英文模型會「含滷蛋」。低延遲可換 eleven_turbo_v2_5
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# 音色微調(可選)
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75

# === GitHub mirror (required — 沒有就沒有可播放的公開 URL) ===
# 生成的 mp3 推到這個 PUBLIC repo,raw URL 結尾天生是 .mp3 → 觸發 Operit 語音條。
# 必須是 public repo,raw URL 才能被 Operit 外部下載播放。
# Token needs Contents: Read+Write scope (fine-grained PAT recommended).
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=cheche20250831-alt
GITHUB_REPO=cheche-voice-mcp
# GITHUB_AUDIO_DIR=generated_audio

# === Optional ===
# Transport: streamable-http (default for HTTP hosting) or stdio (for local testing)
# MCP_TRANSPORT=streamable-http
# Port (Zeabur auto-injects this)
# PORT=8000
